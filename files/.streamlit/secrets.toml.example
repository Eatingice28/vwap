# Copy this file to .streamlit/secrets.toml for local use.
# On Streamlit Community Cloud, paste these lines into
# Settings -> Secrets instead. Never commit the real secrets.toml.

# Password people must type to open your dashboard.
app_password = "choose-a-password"

# Your Polygon.io (now Massive.com) API key.
polygon_api_key = "paste-your-api-key-here"

# Optional. Set to true to use the newer api.massive.com host
# instead of api.polygon.io. Both accept the same key.
use_massive_host = false
