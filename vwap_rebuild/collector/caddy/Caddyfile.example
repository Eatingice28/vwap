# Replace feed.example.com with a subdomain whose A/AAAA record points to this VPS.
# Caddy keeps the backend on localhost and obtains/renews HTTPS automatically when
# public DNS and ports 80/443 are available.

feed.example.com {
    @feed path /feed.json
    handle @feed {
        reverse_proxy 127.0.0.1:8088
    }

    respond "Not found" 404
}
