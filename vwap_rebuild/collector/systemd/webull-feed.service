[Unit]
Description=Read-only Webull market-data feed collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=webullfeed
Group=webullfeed
WorkingDirectory=/opt/webull-feed
EnvironmentFile=/etc/webull-feed.env
ExecStart=/opt/webull-feed/.venv/bin/python -m webull_feed.app
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Restrict the service to the files it needs. The feed directory must be writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/webull-feed
UMask=0077

[Install]
WantedBy=multi-user.target
