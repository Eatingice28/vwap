# Copy to /etc/webull-feed.env, set permissions to 600, then replace placeholders.
# Never commit this completed file or copy it into the dashboard repository.

WEBULL_APP_KEY=replace_with_your_app_key
WEBULL_APP_SECRET=replace_with_your_app_secret

# Confirm the region and production endpoint assigned to your Webull OpenAPI application.
WEBULL_REGION=us
WEBULL_API_ENDPOINT=api.webull.com

# Comma-separated US stock / ETF symbols. SPY and QQQ provide shared context.
WEBULL_WATCHLIST=NVDA,SPY,QQQ
WEBULL_POLL_SECONDS=20
WEBULL_HISTORY_BAR_COUNT=800

# Keep the listener local. Publish only through an authenticated HTTPS reverse proxy.
WEBULL_BIND_HOST=127.0.0.1
WEBULL_PORT=8088
WEBULL_OUTPUT_PATH=/var/lib/webull-feed/feed.json

# Generate a long random value; this protects the reverse-proxied feed endpoint.
# Store the same value in Streamlit secrets as webull_feed_token.
WEBULL_FEED_ACCESS_TOKEN=replace_with_a_long_random_feed_token
WEBULL_LOG_LEVEL=INFO
